    "人民法院案例库": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People's Court Case Database"
          }
        }
      }
    },
    "仅以下字段会发送到云端（绝不发送整篇文档）：": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the following fields are sent to the cloud (the full document is never sent):"
          }
