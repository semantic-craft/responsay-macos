        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the Screenshot Translate shortcut to select an area → recognize it as text → translate it faithfully into the target language. Choose the engine here: Apple Vision recognizes on-device without uploading the screenshot; cloud engines connect directly with your key (stored in the on-device Keychain)."
          }
        }
      }
    },
